@page "/especialista"
@attribute [TabItemOption(Text = "Especialista")]
<PageTitle>Especialista</PageTitle>

<h1>Especialista</h1>

<Table TItem="SpecialistDto" PageItemsSource="PageItemsSource" class="table-demo"
       IsFixedHeader="true"
       RenderMode="TableRenderMode.Table"
       IsAutoRefresh="true"
       AutoRefreshInterval="2000"
       ShowRefresh="true"
       ClickToSelect="true"
       AllowResizing="true"
       ShowColumnList="false"
       AllowDragColumn="true"
       ShowExportButton="true"
       IsPagination="true"
       IsStriped="true"
       IsBordered="true"
       ShowSkeleton="true"
       IsMultipleSelect="true"
       ShowDefaultButtons="true"
       ShowAddButton="true"
       ShowEditButton="false"
       ShowDeleteButton="false"
       ShowToolbar="true"
       ShowAdvancedSearch="false"
       ShowSearch="true"
       ShowExtendButtons="true"
       AutoGenerateColumns="true"
       DoubleClickToEdit="true"
       EditDialogShowMaximizeButton="false"
       EditMode="EditMode.Popup"
       OnQueryAsync="OnQueryAsync"
       OnSaveAsync="SaveAsync"
       OnDeleteAsync="DeleteAsync">
    <TableColumns>
        <TableColumn @bind-Field="@context.Id" Text="Id"
                     Order="10" Visible="false" IsVisibleWhenAdd="false"
                     IsVisibleWhenEdit="true" IsReadonlyWhenEdit="true">
        </TableColumn>

        <TableColumn @bind-Field="@context.IsActive" Text="Activo"
                     Order="11" Visible="false"
                     IsVisibleWhenAdd="false"
                     IsVisibleWhenEdit="true"
                     ComponentType="typeof(Switch)" />

        <TableColumn @bind-Field="@context.LastName" Text="Apellidos"
                     Order="14" Visible="true"
                     RequiredErrorMessage="@Messages.REQUIRED_ERROR_MESSAGE"
                     Required="true" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.Name" Text="Nombres"
                     Order="15" Visible="true"
                     RequiredErrorMessage="@Messages.REQUIRED_ERROR_MESSAGE"
                     Required="true" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.SpecialtyName" Text="Especialidad"
                     Order="16" Visible="true"
                     RequiredErrorMessage="@Messages.REQUIRED_ERROR_MESSAGE"
                     Required="true" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.CollegeName" Text="Colegio Profesional"
                     Order="17" Visible="true" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.CollegeId" Text="N° Colegiatura"
                     Order="18" Visible="true" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.TypeSex" Text="Sexo"
                     Order="30" RequiredErrorMessage="@Messages.REQUIRED_ERROR_MESSAGE"
                     Required="true" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.Birthdate" Text="FecNac"
                     Order="40" FormatString="@Resource.Constants.APPLICATION_DATE_FORMAT"
                     RequiredErrorMessage="@Messages.REQUIRED_ERROR_MESSAGE"
                     Required="true" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.Address" Text="Domicilio"
                     Order="50" RequiredErrorMessage="@Messages.REQUIRED_ERROR_MESSAGE"
                     Required="true" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.TypeDocument" Text="Tipo Documento"
                     Order="12" Visible="false"
                     RequiredErrorMessage="@Messages.REQUIRED_ERROR_MESSAGE"
                     Required="true" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.NumDocument" Text="Nro Documento"
                     Order="13" Visible="false"
                     RequiredErrorMessage="@Messages.REQUIRED_ERROR_MESSAGE"
                     Required="true" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.Phone" Text="Teléfono"
                     Order="60" Visible="false" Sortable="true"
                     Filterable="true" Searchable="true" />

        <TableColumn @bind-Field="@context.Editing"
                     Visible="false"
                     IsVisibleWhenAdd="false"
                     IsVisibleWhenEdit="false" />

        <TableColumn @bind-Field="@context.IsNew"
                     Visible="false"
                     IsVisibleWhenAdd="false"
                     IsVisibleWhenEdit="false" />
    </TableColumns>
</Table>
