@inject DialogService DialogService
@inject HttpInterceptorService Interceptor
@inject ISpecialistService specialistService
@page "/especialista"

<h3>Especialista</h3>

<RadzenStack Orientation="Orientation.Horizontal" class="rz-my-5">
    <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nuevo Especialista" Click=@AddRow />
</RadzenStack>
<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="9" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(SpecialistDto.Id)" Filterable="false" Title="Código" Frozen="true" Width="50px" TextAlign="TextAlign.Center">
            <Template Context="model">
                @model.Id.ToString().PadLeft(6, '0')
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(SpecialistDto.FullName)" Title="Nombres y Apellidos" Frozen="true" Width="200px" Sortable="true" Filterable="true" />
        <RadzenDataGridColumn Property="@nameof(SpecialistDto.Birthdate)" Title="Edad" Frozen="true" Width="80px" Sortable="true" Filterable="true" >
            <Template Context="model">
                @(Convert.ToInt32((DateTime.Today - model.Birthdate).TotalDays / 365.2425))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(SpecialistDto.ProfessionName)" Title="Profesión" Frozen="true" Width="100px" Sortable="true" Filterable="true" />
        <RadzenDataGridColumn TextAlign="TextAlign.Right" Property="@nameof(SpecialistDto.CollegeCode)" Title="N° Colegiatura" Frozen="true" Width="100px" Sortable="true" Filterable="true" />
        <RadzenDataGridColumn Property="@nameof(SpecialistDto.SpecialtyName)" Title="Especialidad" Frozen="true" Width="100px" Sortable="true" Filterable="true" />
        <RadzenDataGridColumn TextAlign="TextAlign.Right" Property="@nameof(SpecialistDto.RneCode)" Title="N° RNE" Frozen="true" Width="100px" Sortable="true" Filterable="true" />
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    IQueryable<SpecialistDto> items;
    IList<SpecialistDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await specialistService.GetAdminSpecialists();
        specialistService.OnChange += StateHasChanged;
        items = specialistService.AdminSpecialists.AsQueryable();

        selectedItems = new List<SpecialistDto>() { items.FirstOrDefault() };
    }

    public void Dispose()
    {
        Interceptor.DisposeEvent();
        specialistService.OnChange -= StateHasChanged;
    }

    async Task AddRow()
    {
        SpecialistDto data = await DialogService.OpenAsync<SpecialistAdd>("Nuevo Especialista");
        if (data != null)
        {
            await specialistService.AddSpecialist(data);
            items = specialistService.AdminSpecialists.AsQueryable();
        }
    }

    async Task EditRow(SpecialistDto model)
    {
        SpecialistDto data = await DialogService.OpenAsync<SpecialistEdit>("Editar Especialista", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await specialistService.UpdateSpecialist(data);
        }
    }

    async Task DeleteRow(SpecialistDto model)
    {
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar el especialista {model.FullName}?", "Eliminar Especialista", new ConfirmOptions() { OkButtonText = "Sí", CancelButtonText = "No" });

        if (isDeleted.GetValueOrDefault())
        {
            await specialistService.DeleteSpecialist(model.Id);
            items = specialistService.AdminSpecialists.AsQueryable();
        }
    }
}