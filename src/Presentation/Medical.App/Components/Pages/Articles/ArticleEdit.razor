@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IBrandService brandService
@inject IFiscalProductService fiscalProductService
@inject IFiscalUnitService fiscalUnitService
@inject ISubCategoryService subCategoryService
@inject IArticleStockService articleStockService

<RadzenTemplateForm TItem="ArticleDto" Data="@model" Submit=@OnSubmit class="rz-px-3">
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Gap="1rem">
                <RadzenFieldset class="rz-pt-2">
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Nombre">
                        <RadzenTextBox @bind-Value=@model.Name Name="Name" />
                    </RadzenFormField>
                    <RadzenRequiredValidator Component="Name" Text="Nombre es requerido" />
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Nombre Común">
                        <RadzenTextBox @bind-Value=@model.CommonName Name="CommonName" />
                    </RadzenFormField>
                    <RadzenRequiredValidator Component="CommonName" Text="Nombre Común es requerido" />
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Marca">
                        <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@brands TextProperty="@nameof(BrandDto.Name)" ValueProperty="@nameof(BrandDto.Name)" AllowClear="true" @bind-Value=@model.BrandName Name="IdBrand" />
                    </RadzenFormField>
                    <RadzenRequiredValidator Component="IdBrand" Text="Marca es requerido" />
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Tamaño">
                        <RadzenNumeric @bind-Value=@model.Size Step="0.01" Name="Size" Format="0.00" />
                    </RadzenFormField>
                    <RadzenNumericRangeValidator Component="Size" Min=0.01 Text="Tamaño debe ser mayor a cero" />
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="SubCategoría">
                        <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@subCategories TextProperty="@nameof(SubCategoryDto.Name)" ValueProperty="@nameof(SubCategoryDto.Name)" AllowClear="true" @bind-Value=@model.SubCategoryName Name="IdSubCategory" />
                    </RadzenFormField>
                    <RadzenRequiredValidator Component="IdSubCategory" Text="SubCategoría es requerido" />
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Descripción">
                        <RadzenTextArea @bind-Value=@model.Description Name="Description" Rows="3" Style="resize: none" />
                    </RadzenFormField>
                    <RadzenRequiredValidator Component="Description" Text="Descripción es requerido" />
                </RadzenFieldset>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Gap="1rem">
                <RadzenFieldset class="rz-pt-2">
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Código Sunat">
                        <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@fiscalProducts TextProperty="@nameof(FiscalProductDto.Name)" ValueProperty="@nameof(FiscalProductDto.Name)" AllowClear="true" @bind-Value=@model.FiscalProductName Name="IdFiscalProduct" />
                    </RadzenFormField>
                    <RadzenRequiredValidator Component="IdFiscalProduct" Text="Código Sunat es requerido" />
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Unidad Sunat">
                        <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@fiscalUnits TextProperty="@nameof(FiscalUnitDto.Name)" ValueProperty="@nameof(FiscalUnitDto.Name)" AllowClear="true" @bind-Value=@model.FiscalUnitName Name="IdFiscalUnit" />
                    </RadzenFormField>
                    <RadzenRequiredValidator Component="IdFiscalUnit" Text="Unidad Sunat es requerido" />
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Costo S/">
                        <RadzenNumeric @bind-Value=@model.Cost Step="0.01" Name="Cost" Format="0.00" />
                    </RadzenFormField>
                    <RadzenNumericRangeValidator Component="Cost" Min=0.01 Text="Costo debe ser mayor a cero" />
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Stock Mínimo">
                        <RadzenNumeric @bind-Value=@model.MinimumStock Step="0.01" Name="MinimumStock" Format="0.00" />
                    </RadzenFormField>
                    <RadzenNumericRangeValidator Component="MinimumStock" Min=0.01 Text="Stock Mínimo debe ser mayor a cero" />
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Stock Actual">
                        <RadzenNumeric @bind-Value=@stock Step="0.01" Name="Stock" Style="width: 22rem" Format="0.00" ReadOnly="true" Disabled="true" />
                    </RadzenFormField>
                    <RadzenFormField class="rz-py-2 rz-w-100" Text="Neto">
                        <RadzenNumeric @bind-Value=@model.NetPrice Step="0.01" Name="Net" Style="width: 22rem" Format="0.00" />
                    </RadzenFormField>
                    <RadzenNumericRangeValidator Component="Net" Min=0.01 Text="Neto debe ser mayor a cero" />
                    <RadzenStack class="rz-py-2" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenLabel Text="En Venta" class="rz-p-1 rz-w-25" />
                        <RadzenCheckBox @bind-Value=@model.IsAllowedSale class="rz-py-2" />
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenStack>
        </RadzenColumn>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-w-100">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" />
        </RadzenStack>
    </RadzenRow>
</RadzenTemplateForm>

@code {
    [Parameter]
    public ArticleDto Param { get; set; }

    RadzenDropDown<string> radzenDropDown;
    string value;
    string brandName = string.Empty;
    string fiscalProductName = string.Empty;
    string fiscalUnitName = string.Empty;

    IEnumerable<BrandDto> brands;
    IEnumerable<SubCategoryDto> subCategories;
    IEnumerable<FiscalProductDto> fiscalProducts;
    IEnumerable<FiscalUnitDto> fiscalUnits;
    int stock;

    ArticleDto model = new ArticleDto();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await brandService.GetBrands();
        brands = brandService.Brands;

        await fiscalProductService.GetFiscalProducts();
        fiscalProducts = fiscalProductService.FiscalProducts;

        await fiscalUnitService.GetFiscalUnits();
        fiscalUnits = fiscalUnitService.FiscalUnits;

        await subCategoryService.GetSubCategories();
        subCategories = subCategoryService.SubCategories;

        stock = await articleStockService.GetStockByArticleId(Param.Id);
    }

    async void OnSubmit(ArticleDto model)
    {
        model.BrandId = (await brandService.GetBrandByName(model.BrandName)).Id;
        model.FiscalProductId = (await fiscalProductService.GetFiscalProductByName(model.FiscalProductName)).Id;
        model.FiscalUnitId = (await fiscalUnitService.GetFiscalUnitByName(model.FiscalUnitName)).Id;
        model.SubCategoryId = (await subCategoryService.GetSubCategoryByName(model.SubCategoryName)).Id;
        DialogService.Close(model);
    }

    protected async override void OnParametersSet()
    {
        model = Param;
    }

    string searchText = "";

    public string SearchText
    {
        get
        {
            return searchText;
        }
        set
        {
            if (searchText != value)
            {
                searchText = value;
            }
        }
    }
}
