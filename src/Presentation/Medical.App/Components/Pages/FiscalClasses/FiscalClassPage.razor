@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IFiscalClassService service
@page "/sunatclase"


<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenStack Orientation="Orientation.Horizontal" class="rz-w-25">
        <h3>Sunat / Clase</h3>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-my-5 rz-w-75">
        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nueva Clase" Click=@AddRow />
    </RadzenStack>
</RadzenStack>
<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Simple" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Left" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ShowPagingSummary="true" PageSize="9" AllowPaging="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(FiscalClassDto.Id)" Filterable="false" Title="Id" Frozen="true" Width="50px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn Property="@nameof(FiscalClassDto.Name)" Title="Nombre" Width="200px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(FiscalClassDto.Code)" Title="Código" Width="100px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(FiscalClassDto.FamilyCode)" Title="Código Familia" Width="100px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    IQueryable<FiscalClassDto> items;
    IList<FiscalClassDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await service.GetAdminFiscalClasses();
        service.OnChange += StateHasChanged;
        items = service.AdminFiscalClasses.AsQueryable();

        selectedItems = new List<FiscalClassDto>() { items.FirstOrDefault() };
    }

    async Task AddRow()
    {
        FiscalClassDto data = await DialogService.OpenAsync<FiscalClassAdd>("Nueva Clase");
        if (data != null)
        {
            await service.AddFiscalClass(data);
            selectedItems.Add(data);
            items = service.AdminFiscalClasses.AsQueryable();
        }
    }

    async Task EditRow(FiscalClassDto model)
    {
        FiscalClassDto data = await DialogService.OpenAsync<FiscalClassEdit>("Editar Clase", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await service.UpdateFiscalClass(data);
        }
    }

    async Task DeleteRow(FiscalClassDto model)
    {
        Interceptor.RegisterEvent();
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar la Clase: {model.Name}?", "Eliminar Clase", new ConfirmOptions() { OkButtonText = Constants.SYSTEM_BOOLEAN_YES, CancelButtonText = Constants.SYSTEM_BOOLEAN_NOT });

        if (isDeleted.GetValueOrDefault())
        {
            await service.DeleteFiscalClass(model.Id);
            service.OnChange += StateHasChanged;
            items = service.AdminFiscalClasses.AsQueryable();
        }
    }
}