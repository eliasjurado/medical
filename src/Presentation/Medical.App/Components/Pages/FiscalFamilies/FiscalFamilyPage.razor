@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IFiscalFamilyService service
@page "/sunatfamilia"

<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenStack Orientation="Orientation.Horizontal" class="rz-w-25">
        <h3>Sunat / Familia</h3>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-my-5 rz-w-75">
        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nueva Familia" Click=@AddRow />
    </RadzenStack>
</RadzenStack>

<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Simple" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Left" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ShowPagingSummary="true" PageSize="9" AllowPaging="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(FiscalFamilyDto.Id)" Filterable="false" Title="Id" Frozen="true" Width="50px" TextAlign="TextAlign.Center"/>
        <RadzenDataGridColumn Property="@nameof(FiscalFamilyDto.Name)" Title="Nombre" Width="200px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(FiscalFamilyDto.Code)" Title="Código" Width="100px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(FiscalFamilyDto.SegmentCode)" Title="Código Segmento" Width="100px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    IQueryable<FiscalFamilyDto> items;
    IList<FiscalFamilyDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await service.GetAdminFiscalFamilies();
        service.OnChange += StateHasChanged;
        items = service.AdminFiscalFamilies.AsQueryable();

        selectedItems = new List<FiscalFamilyDto>() { items.FirstOrDefault() };
    }

    async Task AddRow()
    {
        FiscalFamilyDto data = await DialogService.OpenAsync<FiscalFamilyAdd>("Nueva Familia");
        if (data != null)
        {
            await service.AddFiscalFamily(data);
            selectedItems.Add(data);
            items = service.AdminFiscalFamilies.AsQueryable();
        }
    }

    async Task EditRow(FiscalFamilyDto model)
    {
        FiscalFamilyDto data = await DialogService.OpenAsync<FiscalFamilyEdit>("Editar Familia", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await service.UpdateFiscalFamily(data);
        }
    }

    async Task DeleteRow(FiscalFamilyDto model)
    {
        Interceptor.RegisterEvent();
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar la Familia: {model.Name}?", "Eliminar Familia", new ConfirmOptions() { OkButtonText = Constants.SYSTEM_BOOLEAN_YES, CancelButtonText = Constants.SYSTEM_BOOLEAN_NOT });

        if (isDeleted.GetValueOrDefault())
        {
            await service.DeleteFiscalFamily(model.Id);
            service.OnChange += StateHasChanged;
            items = service.AdminFiscalFamilies.AsQueryable();
        }
    }
}