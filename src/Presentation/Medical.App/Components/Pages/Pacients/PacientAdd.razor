@inject HttpInterceptorService Interceptor
@inject DialogService DialogService

<RadzenTemplateForm TItem="PacientDto" Data="@model" Submit=@OnSubmit class="rz-p-3">
    <RadzenStack Orientation="Orientation.Vertical">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="Tipo Documento" Style="width: 10rem;" />
                        <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeDocumentId)).Cast<Enum>())" @bind-Value=@model.TypeDocumentId
                                        AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Style="width: 20rem" Name="TypeDocumentId" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <div style="width:10rem"></div>
                        <RadzenRequiredValidator Component="TypeDocumentId" Text="Tipo Documento es requerido" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="N° Documento" Style="width: 10rem;" />
                        <RadzenTextBox @bind-Value=@model.NumDocument Name="Documento" Style="width: 20rem" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <div style="width:10rem"></div>
                        <RadzenRequiredValidator Component="Documento" Text="N° Documento es requerido" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="Nombres y Apellidos" Style="width: 10rem;" />
                        <RadzenTextBox @bind-Value=@model.FullName Name="FullName" Style="width: 20rem" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <div style="width:10rem"></div>
                        <RadzenRequiredValidator Component="FullName" Text="Nombres y Apellidos es requerido" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="Sexo" Style="width: 10rem;" />
                        <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeSexId)).Cast<Enum>())" @bind-Value=@model.TypeSexId
                                        AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Style="width: 20rem" Name="TypeSexId" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <div style="width:10rem"></div>
                        <RadzenRequiredValidator Component="TypeSexId" Text="Sexo es requerido" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="Fecha Nacimiento" Style="width: 10rem;" />
                        <RadzenDatePicker Name="Birthdate" @bind-Value="@model.Birthdate" ShowTime="false" Style="width: 12rem;" DateFormat="dd/MM/yyyy" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <div style="width:10rem"></div>
                        <RadzenRequiredValidator Component="Birthdate" Text="Fecha Nacimiento es requerido" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="Dirección" Style="width: 10rem;" />
                        <RadzenTextBox @bind-Value=@model.Address Name="Address" Style="width: 20rem" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <div style="width:10rem"></div>
                        <RadzenRequiredValidator Component="Address" Text="Dirección es requerido" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="Teléfono" Style="width: 10rem;" />
                        <RadzenTextBox @bind-Value=@model.Phone Name="Phone" Style="width: 20rem" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <div style="width:10rem"></div>
                        <RadzenRequiredValidator Component="Phone" Text="Teléfono es requerido" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="Email" Style="width: 10rem;" />
                        <RadzenTextBox @bind-Value=@model.Email Name="Email" Style="width: 20rem" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <div style="width:10rem"></div>
                        <RadzenEmailValidator Component="Email" Text="Formato Email requerido" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Gap="1rem" JustifyContent="JustifyContent.Right">
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" />
            </RadzenStack>
        </RadzenRow>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    PacientDto model = new PacientDto();

    async void OnSubmit(PacientDto model)
    {
        DialogService.Close(model);
    }
}
