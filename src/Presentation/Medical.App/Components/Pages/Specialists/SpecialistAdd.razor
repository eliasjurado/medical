@inject HttpInterceptorService Interceptor
@inject DialogService DialogService

<RadzenTemplateForm TItem="SpecialistDto" Data="@model" Submit=@OnSubmit class="rz-px-3">
    <RadzenStack Orientation="Orientation.Vertical">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">

                    <RadzenFieldset class="rz-pt-2">
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Tipo Documento">
                            <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeDocumentId)).Cast<Enum>())" @bind-Value=@model.TypeDocumentId AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Name="TypeDocumentId" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="TypeDocumentId" Text="Tipo Documento es requerido" />
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="N° Documento">
                            <RadzenTextBox @bind-Value=@model.NumDocument Name="Documento" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Documento" Text="N° Documento es requerido" />
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Nombres y Apellidos">
                            <RadzenTextBox @bind-Value=@model.FullName Name="FullName" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="FullName" Text="Nombres y Apellidos es requerido" />
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Profesión">
                            <RadzenTextBox @bind-Value=@model.ProfessionName Name="ProfessionName" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="ProfessionName" Text="Profesión es requerido" />
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Colegio Profesional">
                            <RadzenTextBox @bind-Value=@model.CollegeName Name="CollegeName" />
                        </RadzenFormField>
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="N° Colegiatura">
                            <RadzenTextBox @bind-Value=@model.CollegeCode Name="CollegeCode" />
                        </RadzenFormField>
                    </RadzenFieldset>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenFieldset class="rz-pt-2">
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Especialidad">
                            <RadzenTextBox @bind-Value=@model.SpecialtyName Name="SpecialtyName" />
                        </RadzenFormField>
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="N° RNE">
                            <RadzenTextBox @bind-Value=@model.RneCode Name="RneCode" />
                        </RadzenFormField>
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Sexo">
                            <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeSexId)).Cast<Enum>())" @bind-Value=@model.TypeSexId AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Name="TypeSexId" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="TypeSexId" Text="Sexo es requerido" />
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Fecha Nacimiento">
                            <RadzenDatePicker Name="Birthdate" @bind-Value="@model.Birthdate" ShowTime="false" DateFormat="dd/MM/yyyy" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Birthdate" Text="Fecha Nacimiento es requerido" />
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Dirección">
                            <RadzenTextBox @bind-Value=@model.Address Name="Address" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Address" Text="Dirección es requerido" />
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Teléfono">
                            <RadzenTextBox @bind-Value=@model.Phone Name="Phone" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Phone" Text="Teléfono es requerido" />
                    </RadzenFieldset>
                </RadzenStack>
            </RadzenColumn>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-w-100">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" />
            </RadzenStack>
        </RadzenRow>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    SpecialistDto model = new SpecialistDto();

    async void OnSubmit(SpecialistDto model)
    {
        DialogService.Close(model);
    }
}
