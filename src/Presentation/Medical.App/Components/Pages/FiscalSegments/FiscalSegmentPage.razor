@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IFiscalSegmentService service
@page "/sunatsegmento"

<h3>Sunat</h3>
<h4>Segmento</h4>

<RadzenStack Orientation="Orientation.Horizontal" class="rz-my-5">
    <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nuevo Segmento" Click=@AddRow />
</RadzenStack>
<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Simple" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Left" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ShowPagingSummary="true" PageSize="9" AllowPaging="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(FiscalSegmentDto.Id)" Filterable="false" Title="Id" Frozen="true" Width="50px" TextAlign="TextAlign.Center"/>
        <RadzenDataGridColumn Property="@nameof(FiscalSegmentDto.Name)" Title="Nombre" Width="200px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(FiscalSegmentDto.Code)" Title="Código" Width="100px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    IQueryable<FiscalSegmentDto> items;
    IList<FiscalSegmentDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await service.GetAdminFiscalSegments();
        service.OnChange += StateHasChanged;
        items = service.AdminFiscalSegments.AsQueryable();

        selectedItems = new List<FiscalSegmentDto>() { items.FirstOrDefault() };
    }

    async Task AddRow()
    {
        FiscalSegmentDto data = await DialogService.OpenAsync<FiscalSegmentAdd>("Nuevo Segmento");
        if (data != null)
        {
            await service.AddFiscalSegment(data);
            selectedItems.Add(data);
            items = service.AdminFiscalSegments.AsQueryable();
        }
    }

    async Task EditRow(FiscalSegmentDto model)
    {
        FiscalSegmentDto data = await DialogService.OpenAsync<FiscalSegmentEdit>("Editar Segmento", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await service.UpdateFiscalSegment(data);
        }
    }

    async Task DeleteRow(FiscalSegmentDto model)
    {
        Interceptor.RegisterEvent();
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar el Segmento: {model.Name}?", "Eliminar Segmento", new ConfirmOptions() { OkButtonText = Resource.Constants.SYSTEM_BOOLEAN_YES, CancelButtonText = Resource.Constants.SYSTEM_BOOLEAN_NOT });

        if (isDeleted.GetValueOrDefault())
        {
            await service.DeleteFiscalSegment(model.Id);
            service.OnChange += StateHasChanged;
            items = service.AdminFiscalSegments.AsQueryable();
        }
    }
}