@inject HttpInterceptorService Interceptor
@inject DialogService DialogService

<RadzenTemplateForm TItem="FiscalProductDto" Data="@model" Submit=@OnSubmit class="rz-w-xl-100">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenLabel Text="Nombre" Style="width: 6rem;" />
                <RadzenTextBox @bind-Value=@model.Name Name="Name" Style="width: 20rem" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <div style="width:6rem"></div>
                <RadzenRequiredValidator Component="Name" Text="Nombre es requerido" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenLabel Text="Código" Style="width: 6rem;" />
                <RadzenTextBox @bind-Value=@model.Code Name="Code" Style="width: 20rem" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <div style="width:6rem"></div>
                <RadzenRequiredValidator Component="Code" Text="Código es requerido" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenLabel Text="Código Clase" Style="width: 6rem;" />
                <RadzenTextBox @bind-Value=@model.ClassCode Name="ClassCode" Style="width: 20rem" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <div style="width:6rem"></div>
                <RadzenRequiredValidator Component="ClassCode" Text="Código Clase es requerido" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" />
            </RadzenStack>
        </RadzenStack>
    </RadzenColumn>
</RadzenTemplateForm>

@code {
    FiscalProductDto model = new FiscalProductDto();

    async void OnSubmit(FiscalProductDto model)
    {
        DialogService.Close(model);
    }
}
