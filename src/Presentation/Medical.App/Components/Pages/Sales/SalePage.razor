@inject AuthenticationStateProvider authenticationStateProvider
@inject NavigationManager navigationManager
@inject IClientService clientService
@inject HttpInterceptorService interceptor
@inject DialogService dialogService
@inject NotificationService notificationService
@inject IAppUserService appUserService
@inject ISerieService serieService
@inject IFiscalTaxService fiscalTaxService
@page "/venta"
@using Medical.App.Components.Pages.Clients

<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenStack Orientation="Orientation.Horizontal" class="rz-w-25">
        <h3>Venta</h3>
    </RadzenStack>
</RadzenStack>

<RadzenTemplateForm TItem="SaleDto" Data="@model" Submit=@OnSubmit class="rz-px-3">
    <RadzenStack Orientation="Orientation.Vertical">
        <RadzenFieldset>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenStack Gap="1rem" class="rz-w-100">
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Usuario">
                            <RadzenTextBox @bind-Value=@user Name="User" Style="width: 25rem" Disabled="true" />
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenStack Gap="1rem" class="rz-w-100">
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Comprobante N°">
                            <RadzenTextBox @bind-Value=@receiptNumber Name="ReceiptNumber" Style="width: 25rem" Disabled="true" />
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenStack Gap="1rem" class="rz-w-100">
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="IGV">
                            <RadzenTextBox @bind-Value=@vatPercentaje Name="VatPercentaje" Style="width: 25rem" Disabled="true" />
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenStack Gap="1rem" class="rz-w-100">
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Venta exenta de IGV">
                            <RadzenTextBox @bind-Value=@isVatExented Name="VatAffected" Style="width: 25rem" Disabled="true" />
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="1rem" class="rz-w-100">
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenFormField class="rz-py-2 rz-w-75" Text="Cliente">
                                <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@clients TextProperty="@nameof(ClientDto.FullName)" ValueProperty="@nameof(ClientDto.FullName)" AllowClear="true" @bind-Value=@model.ClientFullName Name="Cliente" />
                            </RadzenFormField>
                            <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Cliente" Click=@AddClient class="rz-mt-5 rz-mb-3" />
                        </RadzenStack>
                        <RadzenRequiredValidator Component="Cliente" Text="Cliente es requerido" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenStack Gap="1rem" class="rz-w-100">
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Tipo Comprobante">
                            <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeSaleId)).Cast<Enum>())" @bind-Value=@model.TypeSaleId AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Style="width: 20rem" Name="TypeSaleId" Change=@(args=>SetReceiptNumber(args))>
                            </RadzenDropDown>
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="TypeSaleId" Text="Tipo Documento es requerido" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenStack Gap="1rem" class="rz-w-100">
                        <RadzenFormField class="rz-py-2 rz-w-100" Text="Fecha de Venta">
                            <RadzenDatePicker Min="DateTime.Today" Name="SaleDate" @bind-Value="@model.SaleDateTime" ShowTime="true" HourFormat="12" DateFormat="dd/MM/yyyy h:mm tt" />
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset class="rz-py-5">
            <RadzenRow Gap="1rem">
                <RadzenDataGrid PageSize="9" Data="@items" ColumnWidth="300px" SelectionMode="DataGridSelectionMode.Single" AllowSorting="true" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
                    <HeaderTemplate>
                        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Agregar Artículo" Click=@AddRow />
                    </HeaderTemplate>
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(SaleArticleDto.ArticleName)" Title="Artículo" Frozen="true" Width="200px" Sortable="true" Filterable="true" />
                        <RadzenDataGridColumn Property="@nameof(SaleArticleDto.ArticleFiscalUnitName)" Title="Unidad" Frozen="true" Width="60px" Sortable="true" Filterable="true" />
                        <RadzenDataGridColumn Property="@nameof(SaleArticleDto.ArticleStock)" Title="Stock" Frozen="true" Width="60px" Sortable="true" Filterable="true">
                            <Template Context="items">
                                @String.Format("{0:N0}", items.ArticleStock)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="@nameof(SaleArticleDto.Quantity)" Title="Cantidad" Frozen="true" Width="60px" Sortable="true" Filterable="true" />
                        <RadzenDataGridColumn Property="@nameof(SaleArticleDto.ArticleNetPrice)" Title="Precio" Frozen="true" Width="60px" Sortable="true" Filterable="true" />
                        <RadzenDataGridColumn Property="@nameof(SaleArticleDto.SubtotalAmount)" Title="Subtotal" Frozen="true" Width="60px" Sortable="true" Filterable="true" />
                        <RadzenDataGridColumn Property="@nameof(SaleArticleDto.TaxAmount)" Title="IGV" Frozen="true" Width="60px" Sortable="true" Filterable="true" />
                        <RadzenDataGridColumn Property="@nameof(SaleArticleDto.TotalAmount)" Title="Total" Frozen="true" Width="70px" Sortable="true" Filterable="true">
                            <Template Context="items">
                                <RadzenStack Orientation="Orientation.Horizontal">
                                    <div class="rz-w-25">S/</div>
                                    <div class="rz-w-75 rz-text-align-right">@String.Format("{0:N2}", items.TotalAmount)</div>
                                </RadzenStack>
                            </Template>
                            <FooterTemplate>
                                <RadzenStack Orientation="Orientation.Horizontal">
                                    <div class="rz-w-25"><h3><b>S/</b></h3></div>
                                    <div class="rz-w-75 rz-text-align-right"><h3><b>@String.Format("{0:N2}", sumQuantity)</b></h3></div>
                                </RadzenStack>
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
                            <Template Context="model">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenRow Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-w-100">
                <RadzenButton Icon="save" ButtonType="ButtonType.Submit" Text="Guardar" Disabled="disabled" />
            </RadzenStack>
        </RadzenRow>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    List<SaleArticleDto> itemsMap = new List<SaleArticleDto>();
    IQueryable<SaleArticleDto> items;
    SaleDto model = new SaleDto();
    RadzenDropDown<string> radzenDropDown;
    string value;
    IEnumerable<ClientDto> clients;
    decimal sumQuantity = 0;
    DialogOptions dialogOptions = new DialogOptions { Draggable = true };
    string userId;
    string user;
    string receiptNumber;
    bool disabled = false;
    string isVatExented = Constants.SYSTEM_BOOLEAN_NOT;
    string vatPercentaje = string.Empty;
    List<SerieDto> series = new List<SerieDto>();
    decimal taxAmount;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        interceptor.RegisterEvent();

        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.Claims.FirstOrDefault(x => x.Type == ClaimTypes.NameIdentifier).Value;
        var appUser = await appUserService.GetAppUserByUserId(userId);
        if (appUser == null)
        {
            await Task.Run(() => navigationManager!.NavigateTo("/perfil"));
        }
        else
        {
            user = $"{appUser.FirstName} {appUser.LastName}";
            isVatExented = appUser.IsTaxExempted.GetYesNoFromBoolean();
            taxAmount = (await fiscalTaxService.GetFiscalTaxByYear(DateTime.Now.Year)).TaxAmount;
            vatPercentaje = (taxAmount * 100).ToString() + "%";


            await clientService.GetClients();
            clients = clientService.Clients;

            clientService.OnChange += StateHasChanged;

            series = await serieService.GetSeriesByUserId(userId);
            var defaultSerie = series.FirstOrDefault(x => x.TypeSaleId == model.TypeSaleId);
            receiptNumber = GetReceiptCode(defaultSerie);
        }

        if (!itemsMap.Any())
        {
            disabled = true;
        }

    }

    async void OnSubmit(SaleDto model)
    {
        model.ClientId = (await clientService.GetClientByFullName(model.ClientFullName)).Id;
    }

    async Task AddRow()
    {
        SaleArticleDto data = await dialogService.OpenAsync<SaleArticleAdd>("Añadir Artículo", new Dictionary<string, object> { { "SelectedArticles", itemsMap }, { "IsTaxExempted", isVatExented.GetBooleanFromYesNo() }, { "TaxAmount", taxAmount } });
        if (data != null)
        {
            if (!itemsMap.Any())
            {
                disabled = true;
            }
            else
            {
                disabled = false;
            }

            if (data.Quantity > data.ArticleStock)
            {
                var notification = new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Stock Insuficiente",
                        Detail = $"Sin stock suficiente para el artículo \"{data.ArticleName}\"",
                        Duration = 6000,
                    };
                notificationService.Notify(notification);
                disabled = true;
            }
            else
            {
                disabled = false;
            }
            itemsMap.Add(data);
            items = itemsMap.AsQueryable();
            sumQuantity = itemsMap.Sum(x => x.TotalAmount);
        }
    }

    async Task AddClient()
    {
        ClientDto data = await dialogService.OpenAsync<ClientAdd>("Nuevo Cliente", options: dialogOptions);
        if (data != null)
        {
            await clientService.AddClient(data);
            var notification = new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Nuevo Cliente",
                    Detail = $"El cliente \"{data.FullName}\" fue creado exitosamente",
                    Duration = 4000,

                };
            notificationService.Notify(notification);
            clients = clientService.Clients;
        }
    }

    async Task EditRow(SaleArticleDto model)
    {
        if (!itemsMap.Any())
        {
            disabled = true;
        }
        else
        {
            disabled = false;
        }

        SaleArticleDto data = await dialogService.OpenAsync<SaleArticleEdit>("Editar Artículo", new Dictionary<string, object> { { "Param", model }, { "IsTaxExempted", isVatExented.GetBooleanFromYesNo() }, { "TaxAmount", taxAmount } }, dialogOptions);
        if (data != null)
        {
            if (data.Quantity > data.ArticleStock)
            {
                var notification = new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Stock Insuficiente",
                        Detail = $"Sin stock suficiente para el artículo \"{data.ArticleName}\"",
                        Duration = 6000,
                    };
                notificationService.Notify(notification);
                disabled = true;
            }
            else
            {
                disabled = false;
            }
            itemsMap.Remove(model);
            itemsMap.Add(data);
            items = itemsMap.AsQueryable();
            sumQuantity = itemsMap.Sum(x => x.TotalAmount);
        }
    }

    async Task DeleteRow(SaleArticleDto model)
    {
        var isDeleted = await dialogService.Confirm($"¿Está seguro de eliminar el Artículo: {model.ArticleName}?", "Eliminar Artículo", new ConfirmOptions() { OkButtonText = Constants.SYSTEM_BOOLEAN_YES, CancelButtonText = Constants.SYSTEM_BOOLEAN_NOT });

        if (isDeleted.GetValueOrDefault())
        {
            itemsMap.Remove(model);
            items = itemsMap.AsQueryable();
            if (!itemsMap.Any())
            {
                disabled = true;
            }
            else
            {
                disabled = false;
            }

        }
    }

    string searchText = "";

    public string SearchText
    {
        get
        {
            return searchText;
        }
        set
        {
            if (searchText != value)
            {
                searchText = value;
                Console.WriteLine($"Search text: {radzenDropDown.SearchText}");
            }
        }
    }

    void SetReceiptNumber(object args)
    {
        var selectedSerie = series.FirstOrDefault(x => x.TypeSaleId == (TypeSaleId)args);
        receiptNumber = GetReceiptCode(selectedSerie);
        model.Serie = receiptNumber.GetSerieByReceipt();
        model.Correlative = receiptNumber.GetCorrelativeByReceipt();
    }

    string GetReceiptCode(SerieDto serie)
    {
        var val = string.Empty;
        if (serie == null)
        {
            var notification = new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Serie",
                    Detail = $"El usuario no cuenta con una serie asignada para vender con este tipo de comprobante",
                    Duration = 6000,
                };
            notificationService.Notify(notification);
            disabled = true;
        }
        else
        {
            val = $"{serie.TypeSaleId.GetReceiptTypeCode()}{serie.NumSerie.ToString().PadLeft(3, '0')}-{(serie.NumCorrelative + 1).ToString().PadLeft(6, '0')}";
            disabled = false;
        }
        return val;
    }
}
