@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IPacientService pacientService
@inject IClientService clientService

<h3>SaleAdd</h3>

<RadzenTemplateForm TItem="SaleDto" Data="@model" Submit=@OnSubmit class="rz-px-3">
    <RadzenRow Gap="1rem">
        <RadzenStack Gap="1rem">
            <RadzenFieldset class="rz-pt-2">

                <RadzenFormField class="rz-py-2 rz-w-100" Text="Paciente">
                    <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@pacients TextProperty="@nameof(PacientDto.FullName)" ValueProperty="@nameof(PacientDto.FullName)" AllowClear="true" @bind-Value=@model.PacientFullName Name="Paciente" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Paciente" Text="Paciente es requerido" />

                <RadzenFormField class="rz-py-2 rz-w-100" Text="Cliente">
                    <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@clients TextProperty="@nameof(ClientDto.FullName)" ValueProperty="@nameof(ClientDto.FullName)" AllowClear="true" @bind-Value=@model.ClientFullName Name="Cliente" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Cliente" Text="Cliente es requerido" />

                <RadzenFormField class="rz-py-2 rz-w-100" Text="Tipo Documento">
                    <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeSaleId)).Cast<Enum>())" @bind-Value=@model.TypeSaleId AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Style="width: 20rem" Name="TypeSaleId">
                    </RadzenDropDown>
                </RadzenFormField>
                <RadzenRequiredValidator Component="TypeSaleId" Text="Tipo Documento es requerido" />

            </RadzenFieldset>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" />
            </RadzenStack>
        </RadzenStack>
    </RadzenRow>
</RadzenTemplateForm>

@code {
    SaleDto model = new SaleDto();
    RadzenDropDown<string> radzenDropDown;
    string value;
    IEnumerable<PacientDto> pacients;
    IEnumerable<ClientDto> clients;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await pacientService.GetPacients();
        pacients = pacientService.Pacients;

        await clientService.GetClients();
        clients = clientService.Clients;
    }

    async void OnSubmit(SaleDto model)
    {
        model.PacientId = (await pacientService.GetPacientByFullName(model.PacientFullName)).Id;
        model.ClientId = (await clientService.GetClientByFullName(model.ClientFullName)).Id;
        DialogService.Close(model);
    }

    string searchText = "";

    public string SearchText
    {
        get
        {
            return searchText;
        }
        set
        {
            if (searchText != value)
            {
                searchText = value;
                Console.WriteLine($"Search text: {radzenDropDown.SearchText}");
            }
        }
    }

}
