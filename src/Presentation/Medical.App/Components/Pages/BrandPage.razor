@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IBrandService service
@page "/marca"

<h3>Marca</h3>

<RadzenStack Orientation="Orientation.Horizontal" class="rz-my-5">
    <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nueva Marca" Click=@AddRow />
</RadzenStack>
<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" PageSize="9" AllowPaging="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(BrandDto.Id)" Filterable="false" Title="Código" Frozen="true" Width="50px" TextAlign="TextAlign.Center">
            <Template Context="model">
                @model.Id.ToString().PadLeft(6, '0')
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(BrandDto.Name)" Title="Nombre" Width="200px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    IQueryable<BrandDto> items;
    IList<BrandDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await service.GetAdminBrands();
        service.OnChange += StateHasChanged;
        items = service.AdminBrands.AsQueryable();

        selectedItems = new List<BrandDto>() { items.FirstOrDefault() };
    }

    async Task AddRow()
    {
        BrandDto data = await DialogService.OpenAsync<BrandAdd>("Nueva Marca");
        if (data != null)
        {
            await service.AddBrand(data);
            selectedItems.Add(data);
            items = service.AdminBrands.AsQueryable();
        }
    }

    async Task EditRow(BrandDto model)
    {
        BrandDto data = await DialogService.OpenAsync<BrandEdit>("Editar Marca", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await service.UpdateBrand(data);
        }
    }

    async Task DeleteRow(BrandDto model)
    {
        Interceptor.RegisterEvent();
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar la marca {model.Name}?", "Eliminar Marca", new ConfirmOptions() { OkButtonText = "Sí", CancelButtonText = "No" });

        if (isDeleted.GetValueOrDefault())
        {
            await service.DeleteBrand(model.Id);
            service.OnChange += StateHasChanged;
            items = service.AdminBrands.AsQueryable();
        }
    }
}