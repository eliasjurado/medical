@using Medical.App.Models
@using Medical.App.Services.PacientService
@using Medical.App.Services.SpecialistService
@using Medical.App.Services.TreatmentService
@using Medical.Domain.Dto.Pacient
@using Medical.Domain.Dto.Specialist
@using Medical.Domain.Dto.Treatment
@using Medical.Domain.Enums
@inject DialogService DialogService
@inject IPacientService pacientService
@inject ITreatmentService treatmentService
@inject ISpecialistService specialistService

<RadzenTemplateForm TItem="AppointmentViewModel" Data="@model" Submit=@OnSubmit>
    <RadzenStack Gap="1rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Paciente" Style="width: 6rem;" />
            <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
            Data=@pacients TextProperty="@nameof(PacientDto.FullName)" ValueProperty="@nameof(PacientDto.FullName)" AllowClear="true" @bind-Value=@model.PacientFullName Style="width: 20rem" Name="Paciente" />
            <RadzenRequiredValidator Component="Paciente" Text="Paciente is required" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Consultorio" Style="width: 6rem;" />
            <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
            Data=@treatments TextProperty="@nameof(TreatmentDto.Name)" ValueProperty="@nameof(TreatmentDto.Name)" AllowClear="true" @bind-Value=@model.TreatmentName Style="width: 20rem" Name="Consultorio" />
            <RadzenRequiredValidator Component="Consultorio" Text="Consultorio is required" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Especialista" Style="width: 6rem;" />
            <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
            Data=@specialists TextProperty="@nameof(SpecialistDto.FullName)" ValueProperty="@nameof(SpecialistDto.FullName)" AllowClear="true" @bind-Value=@model.SpecialistFullName Style="width: 20rem" Name="Especialista" />
            <RadzenRequiredValidator Component="Especialista" Text="Especialista is required" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Tipo" Style="width: 6rem;" />
            <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeAppointmentId)).Cast<Enum>())" @bind-Value=@model.TypeAppointmentId
            AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Style="width: 20rem" Name="TypeAppointment">
            </RadzenDropDown>
            <RadzenRequiredValidator Component="TypeAppointment" Text="Tipo is required" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Turno" Style="width: 6rem;" />
            <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeShiftId)).Cast<Enum>())" @bind-Value=@model.TypeShiftId
            AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Style="width: 20rem" Name="TypeShift">
            </RadzenDropDown>
            <RadzenRequiredValidator Component="TypeShift" Text="Turno is required" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Inicio" Style="width: 6rem;" />
            <RadzenDatePicker @bind-Value="@model.StartDateTime" Name="StartDateTime" ShowTime="true" Style="width: 12rem;" DateFormat="dd/MM/yyyy hh:mm" />
            <RadzenRequiredValidator Component="StartDateTime" Text="Inicio is required" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Fin" Style="width: 6rem;" />
            <RadzenDatePicker Name="EndDateTime" @bind-Value="@model.EndDateTime" ShowTime="true" Style="width: 12rem;" DateFormat="dd/MM/yyyy hh:mm" />
            <RadzenRequiredValidator Component="EndDateTime" Text="Fin is required" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>
@code {
    [Parameter]
    public AppointmentViewModel Appointment { get; set; }

    RadzenDropDown<string> radzenDropDown;
    string value;

    IEnumerable<PacientDto> pacients;
    IEnumerable<TreatmentDto> treatments;
    IEnumerable<SpecialistDto> specialists;

    AppointmentViewModel model = new AppointmentViewModel();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await pacientService.GetPacients();
        pacients = pacientService.Pacients;

        await treatmentService.GetTreatments();
        treatments = treatmentService.Treatments;

        await specialistService.GetSpecialists();
        specialists = specialistService.Specialists;
    }

    protected async override void OnParametersSet()
    {
        model = Appointment;
        model.PacientId = (await pacientService.GetPacientByFullName(model.PacientFullName)).Id;
        model.TreatmentId = (await treatmentService.GetTreatmentByName(model.TreatmentName)).Id;
        model.SpecialistId = (await specialistService.GetSpecialistByFullName(model.SpecialistFullName)).Id;
    }

    void OnSubmit(AppointmentViewModel model)
    {
        DialogService.Close(model);
    }

    string searchText = "";

    public string SearchText
    {
        get
        {
            return searchText;
        }
        set
        {
            if (searchText != value)
            {
                searchText = value;
                Console.WriteLine($"Search text: {radzenDropDown.SearchText}");
            }
        }
    }
}