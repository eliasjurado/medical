@inject DialogService DialogService
@inject IArticleService articleService
@inject IWarehouseService warehouseService

<RadzenTemplateForm TItem="ArticleStockDto" Data="@model" Submit=@OnSubmit class="rz-px-3">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenStack Gap="1rem">
            <RadzenFieldset class="rz-pt-2">
                <RadzenFormField Text="Artículo" class="rz-py-2 rz-w-100">
                    <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@articles TextProperty="@nameof(ArticleDto.Name)" ValueProperty="@nameof(ArticleDto.Name)" AllowClear="true" @bind-Value=@model.ArticleName Name="IdArticle" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="IdArticle" Text="Artículo es requerido" />
                <RadzenFormField Text="Cantidad" class="rz-py-2 rz-w-100">
                    <RadzenNumeric @bind-Value=@model.Quantity Step="0.01" Name="Quantity" Format="0.00" />
                </RadzenFormField>
                <RadzenNumericRangeValidator Component="Quantity" Min=0.01 Text="Cantidad debe ser mayor a cero" />
                <RadzenFormField Text="Código de Barras" class="rz-py-2 rz-w-100">
                    <RadzenTextBox @bind-Value=@model.BarCode Name="BarCode" Style="width: 20rem" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="BarCode" Text="Código de Barras es requerido" />
                <RadzenFormField Text="Fecha Vencimiento" class="rz-py-2 rz-w-100">
                    <RadzenDatePicker Name="ExpireDate" @bind-Value="@model.ExpireDate" ShowTime="false" DateFormat="dd/MM/yyyy" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="ExpireDate" Text="Fecha Vencimiento es requerido" />
                <RadzenFormField Text="Almacén" class="rz-py-2 rz-w-100">
                    <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@warehouses TextProperty="@nameof(WarehouseDto.Name)" ValueProperty="@nameof(WarehouseDto.Name)" AllowClear="true" @bind-Value=@model.WarehouseName Name="IdWarehouse" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="IdWarehouse" Text="Almacén es requerido" />
                <RadzenFormField Text="Tipo Movimiento" class="rz-py-2 rz-w-100">
                    <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeArticleStockActionId)).Cast<Enum>())" @bind-Value=@model.TypeArticleStockActionId AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Name="TypeArticleStockActionId" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="TypeArticleStockActionId" Text="Tipo Movimiento es requerido" />
                <RadzenFormField Text="Fecha Movimiento" class="rz-py-2 rz-w-100">
                    <RadzenDatePicker Name="InventoryDateTime" @bind-Value="@model.InventoryDateTime" ShowTime="true" HourFormat="12" DateFormat="dd/MM/yyyy h:mm tt" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="InventoryDateTime" Text="Fecha Movimiento es requerido" />
            </RadzenFieldset>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" />
            </RadzenStack>
        </RadzenStack>
    </RadzenColumn>
</RadzenTemplateForm>

@code {
    RadzenDropDown<string> radzenDropDown;

    IEnumerable<ArticleDto> articles;
    IEnumerable<WarehouseDto> warehouses;
    ArticleStockDto model = new ArticleStockDto();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await articleService.GetArticles();
        articles = articleService.Articles;

        await warehouseService.GetWarehouses();
        warehouses = warehouseService.Warehouses;
    }

    async void OnSubmit(ArticleStockDto model)
    {
        model.Quantity = int.Abs(model.Quantity);
        if (model.TypeArticleStockActionId == TypeArticleStockActionId.Sale || model.TypeArticleStockActionId == TypeArticleStockActionId.Withdrawal || model.TypeArticleStockActionId == TypeArticleStockActionId.Wastage)
        {
            model.Quantity = model.Quantity * -1;
        }
        model.ArticleId = (await articleService.GetArticleByName(model.ArticleName)).Id;
        model.WarehouseId = (await warehouseService.GetWarehouseByName(model.WarehouseName)).Id;
        DialogService.Close(model);
    }

    string searchText = "";

    public string SearchText
    {
        get
        {
            return searchText;
        }
        set
        {
            if (searchText != value)
            {
                searchText = value;
            }
        }
    }
}
