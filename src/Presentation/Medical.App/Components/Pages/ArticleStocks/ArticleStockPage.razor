@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IArticleStockService articleStockService
@inject IArticleService articleService
@inject IWarehouseService warehouseService
@page "/stock"

<h3>Movimiento de Stock</h3>

<RadzenStack Orientation="Orientation.Horizontal" class="rz-my-5">
    <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nuevo Movimiento de Stock" Click=@AddRow />
</RadzenStack>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" class="rz-my-5 rz-align-items-center">
    <RadzenLabel Text="Artículo" Style="width: 4rem;" />
    <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
                    Data=@articles TextProperty="@nameof(ArticleDto.Name)" ValueProperty="@nameof(ArticleDto.Name)" AllowClear="true" @bind-Value=@articleName Style="width: 28rem" Name="IdArticle" />
    <RadzenLabel Text="Almacén" Style="width: 4rem;" />
    <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
                    Data=@warehouses TextProperty="@nameof(WarehouseDto.Name)" ValueProperty="@nameof(WarehouseDto.Name)" AllowClear="true" @bind-Value=@warehouseName Style="width: 15rem" Name="IdWarehouse" />
    <RadzenButton Icon="search" Text="Filtrar" Click=@FilterList />
</RadzenStack>

<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Simple" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Left" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ShowPagingSummary="true" PageSize="9" AllowPaging="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(ArticleStockDto.Id)" Filterable="false" Title="Id" Frozen="true" Width="50px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn Property="@nameof(ArticleStockDto.ArticleName)" Title="Artículo" Width="200px" Sortable="true" Filterable="true" Frozen="true">
            <FooterTemplate>
                Total Stock: <b>@String.Format("{0:N2}", sumQuantity)</b>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(ArticleStockDto.WarehouseName)" Title="Almacén" Width="110px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(ArticleStockDto.Quantity)" Title="Cantidad" Width="70px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(ArticleStockDto.TypeArticleStockActionId)" Title="Tipo" Width="90px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(ArticleStockDto.InventoryDateTime)" Title="Fecha" Frozen="true" Width="110px" Sortable="true" Filterable="true" FormatString="{0:dd/MM/yyyy hh:mm tt}" />
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {

    void FilterList()
    {
        items = articleStockService.AdminArticleStocks.AsQueryable();

        if (!string.IsNullOrWhiteSpace(articleName))
        {
            items = items.Where(x => x.ArticleName.Equals(articleName));
        }
        if (!string.IsNullOrWhiteSpace(warehouseName))
        {
            items = items.Where(x => x.WarehouseName.Equals(warehouseName));
        }

        sumQuantity = items.Sum(x => x.Quantity);
    }

    RadzenDropDown<string> radzenDropDown;

    IEnumerable<ArticleDto> articles;
    IEnumerable<WarehouseDto> warehouses;

    string articleName = string.Empty;
    string warehouseName = string.Empty;
    decimal sumQuantity = 0;

    IQueryable<ArticleStockDto> items;
    IList<ArticleStockDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await articleService.GetArticles();
        articles = articleService.Articles;

        await warehouseService.GetWarehouses();
        warehouses = warehouseService.Warehouses;

        await articleStockService.GetAdminArticleStocks();
        articleStockService.OnChange += StateHasChanged;
        items = articleStockService.AdminArticleStocks.AsQueryable();
        sumQuantity = items.Sum(x => x.Quantity);

        selectedItems = new List<ArticleStockDto>() { items.FirstOrDefault() };
    }

    async Task AddRow()
    {
        ArticleStockDto data = await DialogService.OpenAsync<ArticleStockAdd>("Nuevo Movimiento de Stock");
        if (data != null)
        {
            await articleStockService.AddArticleStock(data);
            selectedItems.Add(data);
            items = articleStockService.AdminArticleStocks.AsQueryable();
            sumQuantity = items.Sum(x => x.Quantity);
        }
    }

    async Task EditRow(ArticleStockDto model)
    {
        ArticleStockDto data = await DialogService.OpenAsync<ArticleStockEdit>("Editar Movimiento de Stock", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await articleStockService.UpdateArticleStock(data);
            items = articleStockService.AdminArticleStocks.AsQueryable();
            sumQuantity = items.Sum(x => x.Quantity);
        }
    }

    async Task DeleteRow(ArticleStockDto model)
    {
        Interceptor.RegisterEvent();
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar el Movimiento de Stock correspondiente al Artículo: {model.ArticleName}?", "Eliminar Movimiento de Stock", new ConfirmOptions() { OkButtonText = Constants.SYSTEM_BOOLEAN_YES, CancelButtonText = Constants.SYSTEM_BOOLEAN_NOT });

        if (isDeleted.GetValueOrDefault())
        {
            await articleStockService.DeleteArticleStock(model.Id);
            articleStockService.OnChange += StateHasChanged;
            items = articleStockService.AdminArticleStocks.AsQueryable();
            sumQuantity = items.Sum(x => x.Quantity);
        }
    }

    string searchText = "";

    public string SearchText
    {
        get
        {
            return searchText;
        }
        set
        {
            if (searchText != value)
            {
                searchText = value;
            }
        }
    }
}