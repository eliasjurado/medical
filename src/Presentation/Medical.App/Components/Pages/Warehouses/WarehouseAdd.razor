@inject DialogService DialogService

<RadzenTemplateForm TItem="WarehouseDto" Data="@model" Submit=@OnSubmit class="rz-px-3">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenStack Gap="1rem">
            <RadzenFieldset class="rz-pt-2">
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Nombre">
                    <RadzenTextBox @bind-Value=@model.Name Name="Name" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Name" Text="Nombre es requerido" />
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Ubicación">
                    <RadzenTextBox @bind-Value=@model.Address Name="Address" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Address" Text="Ubicación es requerido" />
            </RadzenFieldset>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" />
            </RadzenStack>
        </RadzenStack>
    </RadzenColumn>
</RadzenTemplateForm>

@code {
    WarehouseDto model = new WarehouseDto();

    async void OnSubmit(WarehouseDto model)
    {
        DialogService.Close(model);
    }
}
