@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IWarehouseService warehouseService
@page "/almacen"

<h3>Almacén</h3>

<RadzenStack Orientation="Orientation.Horizontal" class="rz-my-5">
    <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nuevo Almacén" Click=@AddRow />
</RadzenStack>
<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Simple" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Left" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ShowPagingSummary="true" PageSize="9" AllowPaging="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(WarehouseDto.Id)" Filterable="false" Title="Id" Frozen="true" Width="50px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn Property="@nameof(WarehouseDto.Name)" Title="Nombre" Width="200px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    IQueryable<WarehouseDto> items;
    IList<WarehouseDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await warehouseService.GetAdminWarehouses();
        warehouseService.OnChange += StateHasChanged;
        items = warehouseService.AdminWarehouses.AsQueryable();

        selectedItems = new List<WarehouseDto>() { items.FirstOrDefault() };
    }

    async Task AddRow()
    {
        WarehouseDto data = await DialogService.OpenAsync<WarehouseAdd>("Nuevo Almacén");
        if (data != null)
        {
            await warehouseService.AddWarehouse(data);
            selectedItems.Add(data);
            items = warehouseService.AdminWarehouses.AsQueryable();
        }
    }

    async Task EditRow(WarehouseDto model)
    {
        WarehouseDto data = await DialogService.OpenAsync<WarehouseEdit>("Editar Almacén", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await warehouseService.UpdateWarehouse(data);
        }
    }

    async Task DeleteRow(WarehouseDto model)
    {
        Interceptor.RegisterEvent();
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar el Almacén: {model.Name}?", "Eliminar Almacén", new ConfirmOptions() { OkButtonText = Constants.SYSTEM_BOOLEAN_YES, CancelButtonText = Constants.SYSTEM_BOOLEAN_NOT });

        if (isDeleted.GetValueOrDefault())
        {
            await warehouseService.DeleteWarehouse(model.Id);
            warehouseService.OnChange += StateHasChanged;
            items = warehouseService.AdminWarehouses.AsQueryable();
        }
    }
}