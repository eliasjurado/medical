@inject HttpInterceptorService Interceptor
@inject DialogService DialogService

<RadzenTemplateForm TItem="SerieDto" Data="@model" Submit=@OnSubmit class="rz-w-xl-100">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenLabel Text="NumSerie" Style="width: 6rem;" />
                <RadzenNumeric @bind-Value=@model.NumSerie Name="NumSerie" Style="width: 20rem" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <div style="width:6rem"></div>
                <RadzenRequiredValidator Component="NumSerie" Text="NumSerie es requerido" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenLabel Text="NumCorrelative" Style="width: 6rem;" />
                <RadzenNumeric @bind-Value=@model.NumCorrelative Name="NumCorrelative" Style="width: 20rem" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <div style="width:6rem"></div>
                <RadzenRequiredValidator Component="NumCorrelative" Text="NumCorrelative es requerido" />
            </RadzenStack>
            @*<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenLabel Text="Costo S/" Style="width: 6rem;" />
                <RadzenNumeric @bind-Value=@model.Cost Step="0.01" Name="Cost" Style="width: 20rem" Format="0.00" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <div style="width:6rem"></div>
                <RadzenNumericRangeValidator Component="Cost" Min=0.01 Text="Costo debe ser mayor a cero" />
            </RadzenStack> *@
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Icon="save" ButtonType="ButtonType.Submit" Text="Guardar" />
            </RadzenStack>
        </RadzenStack>
    </RadzenColumn>

</RadzenTemplateForm>

@code {
    [Parameter]
    public SerieDto Param { get; set; }

    SerieDto model = new SerieDto();

    async void OnSubmit(SerieDto model)
    {
        DialogService.Close(model);
    }

    protected async override void OnParametersSet()
    {
        model = Param;
    }
}
