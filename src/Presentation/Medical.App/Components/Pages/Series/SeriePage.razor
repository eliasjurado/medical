@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject ISerieService serieService
@page "/serie"

<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenStack Orientation="Orientation.Horizontal" class="rz-w-25">
        <h3>Serie</h3>
    </RadzenStack>
</RadzenStack>
<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Simple" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Left" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ShowPagingSummary="true" PageSize="9" AllowPaging="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <HeaderTemplate>
        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nueva Serie" Click=@AddRow />
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(SerieDto.Id)" Filterable="false" Title="Id" Frozen="true" Width="50px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn Property="@nameof(SerieDto.AppUserEmail)" Title="Usuario" Width="50px" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(SerieDto.TypeSaleId)" Filterable="false" Title="Tipo Documento" Frozen="true" Width="50px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn Property="@nameof(SerieDto.NumSerie)" Title="Serie" Width="50px" Sortable="true" Filterable="true" Frozen="true">
            <Template Context="model">
                @model.NumSerie.ToString().PadLeft(3, '0')
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(SerieDto.NumCorrelative)" Title="Correlativo" Width="50px" Frozen="true">
            <Template Context="model">
                @model.NumCorrelative.ToString().PadLeft(6, '0')
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    IQueryable<SerieDto> items;
    IList<SerieDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await serieService.GetAdminSeries();
        serieService.OnChange += StateHasChanged;
        items = serieService.AdminSeries.AsQueryable();

        selectedItems = new List<SerieDto>() { items.FirstOrDefault() };
    }

    async Task AddRow()
    {
        SerieDto data = await DialogService.OpenAsync<SerieAdd>("Nueva Serie");
        if (data != null)
        {
            await serieService.AddSerie(data);
            selectedItems.Add(data);
            items = serieService.AdminSeries.AsQueryable();
        }
    }

    async Task EditRow(SerieDto model)
    {
        SerieDto data = await DialogService.OpenAsync<SerieEdit>("Editar Serie", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await serieService.UpdateSerie(data);
        }
    }

    async Task DeleteRow(SerieDto model)
    {
        Interceptor.RegisterEvent();
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar la Serie: {model.TypeSaleId.GetDisplayDescription()}-{model.NumSerie.ToString().PadLeft(3, '0')}?", "Eliminar Serie", new ConfirmOptions() { OkButtonText = Constants.SYSTEM_BOOLEAN_YES, CancelButtonText = Constants.SYSTEM_BOOLEAN_NOT });

        if (isDeleted.GetValueOrDefault())
        {
            await serieService.DeleteSerie(model.Id);
            serieService.OnChange += StateHasChanged;
            items = serieService.AdminSeries.AsQueryable();
        }
    }
}