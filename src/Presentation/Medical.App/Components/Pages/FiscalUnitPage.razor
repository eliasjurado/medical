@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IFiscalUnitService service
@page "/sunatunidad"

<h3>Sunat</h3>
<h4>Unidad Medida</h4>

<RadzenStack Orientation="Orientation.Horizontal" class="rz-my-5">
    <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nueva Unidad Medida" Click=@AddRow />
</RadzenStack>
<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" PageSize="9" AllowPaging="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(FiscalUnitDto.Id)" Filterable="false" Title="Código" Frozen="true" Width="50px" TextAlign="TextAlign.Center">
            <Template Context="model">
                @model.Id.ToString().PadLeft(6, '0')
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(FiscalUnitDto.Name)" Title="Nombre" Width="200px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(FiscalUnitDto.Code)" Title="Abreviatura" Width="100px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    IQueryable<FiscalUnitDto> items;
    IList<FiscalUnitDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await service.GetAdminFiscalUnits();
        service.OnChange += StateHasChanged;
        items = service.AdminFiscalUnits.AsQueryable();

        selectedItems = new List<FiscalUnitDto>() { items.FirstOrDefault() };
    }

    async Task AddRow()
    {
        FiscalUnitDto data = await DialogService.OpenAsync<FiscalUnitAdd>("Nueva Unidad Medida");
        if (data != null)
        {
            await service.AddFiscalUnit(data);
            selectedItems.Add(data);
            items = service.AdminFiscalUnits.AsQueryable();
        }
    }

    async Task EditRow(FiscalUnitDto model)
    {
        FiscalUnitDto data = await DialogService.OpenAsync<FiscalUnitEdit>("Editar Unidad Medida", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await service.UpdateFiscalUnit(data);
        }
    }

    async Task DeleteRow(FiscalUnitDto model)
    {
        Interceptor.RegisterEvent();
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar la Unidad Medida: {model.Name}?", "Eliminar Unidad Medida", new ConfirmOptions() { OkButtonText = "Sí", CancelButtonText = "No" });

        if (isDeleted.GetValueOrDefault())
        {
            await service.DeleteFiscalUnit(model.Id);
            service.OnChange += StateHasChanged;
            items = service.AdminFiscalUnits.AsQueryable();
        }
    }
}