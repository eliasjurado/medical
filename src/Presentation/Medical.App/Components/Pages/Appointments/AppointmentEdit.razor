@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IPacientService pacientService
@inject ITreatmentService treatmentService
@inject ISpecialistService specialistService

<RadzenTemplateForm TItem="AppointmentViewModel" Data="@model" Submit=@OnSubmit class="rz-px-3">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenStack Gap="1rem">
            <RadzenFieldset class="rz-pt-2">
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Paciente">
                    <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@pacients TextProperty="@nameof(PacientDto.FullName)" ValueProperty="@nameof(PacientDto.FullName)" AllowClear="true" @bind-Value=@model.PacientFullName Name="Paciente" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Paciente" Text="Paciente es requerido" />
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Servicio">
                    <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@treatments TextProperty="@nameof(TreatmentDto.Name)" ValueProperty="@nameof(TreatmentDto.Name)" AllowClear="true" @bind-Value=@model.TreatmentName Name="Consultorio" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Consultorio" Text="Consultorio es requerido" />
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Especialista">
                    <RadzenDropDown @ref=@radzenDropDown @bind-SearchText=SearchText FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" Data=@specialists TextProperty="@nameof(SpecialistDto.FullName)" ValueProperty="@nameof(SpecialistDto.FullName)" AllowClear="true" @bind-Value=@model.SpecialistFullName Name="Especialista" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Especialista" Text="Especialista es requerido" />
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Tipo">
                    <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeAppointmentId)).Cast<Enum>())" @bind-Value=@model.TypeAppointmentId AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Name="TypeAppointment">
                    </RadzenDropDown>
                </RadzenFormField>
                <RadzenRequiredValidator Component="TypeAppointment" Text="Tipo es requerido" />
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Turno">
                    <RadzenDropDown Data="@(Enum.GetValues(typeof(TypeShiftId)).Cast<Enum>())" @bind-Value=@model.TypeShiftId AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Name="TypeShift">
                    </RadzenDropDown>
                </RadzenFormField>
                <RadzenRequiredValidator Component="TypeShift" Text="Turno es requerido" />
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Cita">
                    <RadzenDatePicker @bind-Value="@model.StartDateTime" Name="StartDateTime" ShowTime="true" HourFormat="12" DateFormat="dd/MM/yyyy h:mm tt" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="StartDateTime" Text="Cita es requerido" />
            </RadzenFieldset>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Icon="save" ButtonType="ButtonType.Submit" Text="Guardar" />
            </RadzenStack>
        </RadzenStack>
    </RadzenColumn>
</RadzenTemplateForm>
@code {
    [Parameter]
    public AppointmentViewModel Appointment { get; set; }

    RadzenDropDown<string> radzenDropDown;
    string value;

    IEnumerable<PacientDto> pacients;
    IEnumerable<TreatmentDto> treatments;
    IEnumerable<SpecialistDto> specialists;

    AppointmentViewModel model = new AppointmentViewModel();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await pacientService.GetPacients();
        pacients = pacientService.Pacients;

        await treatmentService.GetTreatments();
        treatments = treatmentService.Treatments;

        await specialistService.GetSpecialists();
        specialists = specialistService.Specialists;
    }

    protected async override void OnParametersSet()
    {
        model = Appointment;
        model.PacientId = (await pacientService.GetPacientByFullName(model.PacientFullName)).Id;
        model.TreatmentId = (await treatmentService.GetTreatmentByName(model.TreatmentName)).Id;
        model.SpecialistId = (await specialistService.GetSpecialistByFullName(model.SpecialistFullName)).Id;
    }

    void OnSubmit(AppointmentViewModel model)
    {
        model.EndDateTime = model.StartDateTime.AddMinutes(Constants.APPOINTMENTS_DEFAULT_TIME_ELAPSE);
        DialogService.Close(model);
    }

    string searchText = "";

    public string SearchText
    {
        get
        {
            return searchText;
        }
        set
        {
            if (searchText != value)
            {
                searchText = value;
                Console.WriteLine($"Search text: {radzenDropDown.SearchText}");
            }
        }
    }
}