@page "/login"
@layout LoginLayout
@* @inject ICartService CartService *@
@* @implements IDisposable *@

<PageTitle>Login</PageTitle>


<RadzenRow Gap="6" class="rz-my-6 rz-mx-auto rz-border-radius-6 rz-shadow-10" Style="width: 100%; height:100%; overflow: hidden;">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard class="rz-shadow-0 rz-border-radius-0 rz-text-align-center rz-p-12" Style="height: 100%; background: #1b9e41 no-repeat 100% 70% fixed url('data:image/svg+xml;base64,')">
            <RadzenImage Path="./images/logo.png" class="rz-my-6 rz-border-radius-6" Style="width:100px" />
            <RadzenText TextStyle="TextStyle.DisplayH3" TagName="TagName.H2" class="rz-color-white rz-mb-6">@Resource.Constants.APPLICATION_NAME</RadzenText>
            <RadzenText TextStyle="TextStyle.H6" class="rz-color-white">@Resource.Constants.SYSTEM_LEAD</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-white">Ingresa con tu <strong>usuario</strong> y <strong>contraseña</strong>.</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard class="rz-shadow-0 rz-border-radius-0 rz-p-12">
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mt-6 rz-mb-9">
                @Resource.Constants.LOGIN_FORM_TITLE
            </RadzenText>
            <RadzenLogin UserText="Usuario"
                         PasswordText="Contraseña"
                         LoginText="Ingresar"
                         Login=HandleLogin
                         AllowRegister="false"
                         AllowResetPassword="false" />
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

