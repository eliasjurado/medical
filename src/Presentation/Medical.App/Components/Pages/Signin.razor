@page "/login"
@layout LoginLayout
@* @inject ICartService CartService *@
@* @implements IDisposable *@

<PageTitle>Login</PageTitle>

<div class="login-item login-item-avatar login-item-gitee">
    <div class="text-center">
        <RadzenImage Path="./images/logo.png" class="rz-border-radius-6" Style="width:100px" />
        <h1 class="text-dark">@Resource.Constants.APPLICATION_NAME</h1>
        <h4 class="text-dark">@Resource.Constants.SYSTEM_LEAD</h4>
        <h4>@Resource.Constants.LOGIN_FORM_TITLE</h4>
    </div>

    <EditForm Model="user" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <div class="m-3">
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
            <InputText id="email" @bind-Value="user.Email" class="form-control p-2 m-2" type="email" placeholder="@Resource.Constants.LOGIN_FORM_EMAIL_PLACEHOLDER" />
            <ValidationMessage class="p-2 m-2" For="@(() => user.Email)" />
        </div>
        <div class="m-3">
            <InputText id="password" @bind-Value="user.Password" class="form-control p-2 m-2" type="password" placeholder="@Resource.Constants.LOGIN_FORM_PASSWORD_PLACEHOLDER" />
            <ValidationMessage class="p-2 m-2" For="@(() => user.Password)" />
        </div>
        <div class="m-3">
            <RadzenButton class="p-2 m-2" Text="Ingresar" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
        </div>
    </EditForm>
    <hr />
    <div class="d-flex m-3">
        <RadzenButton class="p-2 m-2" Text="@Resource.Constants.LOGIN_FORM_FORGOT_PASSWORD" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Danger" />
        <RadzenButton class="p-2 m-2" Text="@Resource.Constants.LOGIN_FORM_REGISTER" ButtonStyle="ButtonStyle.Info" ButtonType="ButtonType.Button" />
    </div>
    <div class="text-danger">
        <span>@errorMessage</span>
    </div>

</div>
<script>
    console.log(@response);
</script>