@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject ITreatmentService treatmentService
@page "/servicio"

<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenStack Orientation="Orientation.Horizontal" class="rz-w-25">
        <h3>Servicio</h3>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-my-5 rz-w-75">
        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nuevo Servicio" Click=@AddRow />
    </RadzenStack>
</RadzenStack>
<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Simple" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Left" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ShowPagingSummary="true" PageSize="9" AllowPaging="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(TreatmentDto.Id)" Filterable="false" Title="Id" Frozen="true" Width="50px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn Property="@nameof(TreatmentDto.Name)" Title="Nombre" Width="200px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(TreatmentDto.Cost)" Title="Costo" Width="50px" FormatString="{0:C2}" Frozen="true">
            <Template Context="model">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <div class="rz-w-25">S/</div>
                    <div class="rz-w-75 rz-text-align-right">@model.Cost</div>
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    IQueryable<TreatmentDto> items;
    IList<TreatmentDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await treatmentService.GetAdminTreatments();
        treatmentService.OnChange += StateHasChanged;
        items = treatmentService.AdminTreatments.AsQueryable();

        selectedItems = new List<TreatmentDto>() { items.FirstOrDefault() };
    }

    async Task AddRow()
    {
        TreatmentDto data = await DialogService.OpenAsync<TreatmentAdd>("Nuevo Servicio");
        if (data != null)
        {
            await treatmentService.AddTreatment(data);
            selectedItems.Add(data);
            items = treatmentService.AdminTreatments.AsQueryable();
        }
    }

    async Task EditRow(TreatmentDto model)
    {
        TreatmentDto data = await DialogService.OpenAsync<TreatmentEdit>("Editar Servicio", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await treatmentService.UpdateTreatment(data);
        }
    }

    async Task DeleteRow(TreatmentDto model)
    {
        Interceptor.RegisterEvent();
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar el Servicio: {model.Name}?", "Eliminar Servicio", new ConfirmOptions() { OkButtonText = Constants.SYSTEM_BOOLEAN_YES, CancelButtonText = Constants.SYSTEM_BOOLEAN_NOT });

        if (isDeleted.GetValueOrDefault())
        {
            await treatmentService.DeleteTreatment(model.Id);
            treatmentService.OnChange += StateHasChanged;
            items = treatmentService.AdminTreatments.AsQueryable();
        }
    }
}