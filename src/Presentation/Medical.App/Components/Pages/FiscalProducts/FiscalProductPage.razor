@inject HttpInterceptorService Interceptor
@inject DialogService DialogService
@inject IFiscalProductService service
@page "/sunatproducto"

<h3>Sunat</h3>
<h4>Producto</h4>

<RadzenStack Orientation="Orientation.Horizontal" class="rz-my-5">
    <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nuevo Producto" Click=@AddRow />
</RadzenStack>
<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Simple" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Left" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" ShowPagingSummary="true" PageSize="9" AllowPaging="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(FiscalProductDto.Id)" Filterable="false" Title="Id" Frozen="true" Width="50px" TextAlign="TextAlign.Center"/>
        <RadzenDataGridColumn Property="@nameof(FiscalProductDto.Name)" Title="Nombre" Width="200px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(FiscalProductDto.Code)" Title="Código" Width="100px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(FiscalProductDto.ClassCode)" Title="Código Clase" Width="100px" Sortable="true" Filterable="true" Frozen="true" />
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    IQueryable<FiscalProductDto> items;
    IList<FiscalProductDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await service.GetAdminFiscalProducts();
        service.OnChange += StateHasChanged;
        items = service.AdminFiscalProducts.AsQueryable();

        selectedItems = new List<FiscalProductDto>() { items.FirstOrDefault() };
    }

    async Task AddRow()
    {
        FiscalProductDto data = await DialogService.OpenAsync<FiscalProductAdd>("Nuevo Producto");
        if (data != null)
        {
            await service.AddFiscalProduct(data);
            selectedItems.Add(data);
            items = service.AdminFiscalProducts.AsQueryable();
        }
    }

    async Task EditRow(FiscalProductDto model)
    {
        FiscalProductDto data = await DialogService.OpenAsync<FiscalProductEdit>("Editar Producto", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await service.UpdateFiscalProduct(data);
        }
    }

    async Task DeleteRow(FiscalProductDto model)
    {
        Interceptor.RegisterEvent();
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar el Producto: {model.Name}?", "Eliminar Producto", new ConfirmOptions() { OkButtonText = Constants.SYSTEM_BOOLEAN_YES, CancelButtonText = Constants.SYSTEM_BOOLEAN_NOT });

        if (isDeleted.GetValueOrDefault())
        {
            await service.DeleteFiscalProduct(model.Id);
            service.OnChange += StateHasChanged;
            items = service.AdminFiscalProducts.AsQueryable();
        }
    }
}