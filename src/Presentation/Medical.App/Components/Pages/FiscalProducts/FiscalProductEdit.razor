@inject HttpInterceptorService Interceptor
@inject DialogService DialogService

<RadzenTemplateForm TItem="FiscalProductDto" Data="@model" Submit=@OnSubmit class="rz-px-3">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenStack Gap="1rem">
            <RadzenFieldset class="rz-pt-2">
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Nombre">
                    <RadzenTextBox @bind-Value=@model.Name Name="Name" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Name" Text="Nombre es requerido" />
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Código">
                    <RadzenTextBox @bind-Value=@model.Code Name="Code" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Code" Text="Código es requerido" />
                <RadzenFormField class="rz-py-2 rz-w-100" Text="Código Clase">
                    <RadzenTextBox @bind-Value=@model.ClassCode Name="ClassCode" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="ClassCode" Text="Código Clase es requerido" />
            </RadzenFieldset>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" />
            </RadzenStack>
        </RadzenStack>
    </RadzenColumn>
</RadzenTemplateForm>

@code {
    [Parameter]
    public FiscalProductDto Param { get; set; }

    FiscalProductDto model = new FiscalProductDto();

    async void OnSubmit(FiscalProductDto model)
    {
        DialogService.Close(model);
    }

    protected async override void OnParametersSet()
    {
        model = Param;
    }
}
