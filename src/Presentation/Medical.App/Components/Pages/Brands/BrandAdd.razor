@inject HttpInterceptorService Interceptor
@inject DialogService DialogService

<RadzenTemplateForm TItem="BrandDto" Data="@model" Submit=@OnSubmit class="rz-px-3">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenStack Gap="1rem">
            <RadzenFieldset class="rz-pt-2">
                <RadzenFormField Text="Nombre" class="rz-py-2 rz-w-100">
                    <RadzenTextBox @bind-Value=@model.Name Name="Name" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Name" Text="Nombre es requerido" />
                <RadzenFormField Text="Razón Social" class="rz-py-2 rz-w-100">
                    <RadzenTextBox @bind-Value=@model.BusinessName Name="BusinessName" />
                </RadzenFormField>
                <RadzenFormField Text="RUC" class="rz-py-2 rz-w-100">
                    <RadzenTextBox @bind-Value=@model.RucCode Name="RucCode" />
                </RadzenFormField>
            </RadzenFieldset>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Icon="save" ButtonType="ButtonType.Submit" Text="Guardar" />
            </RadzenStack>
        </RadzenStack>
    </RadzenColumn>
</RadzenTemplateForm>

@code {
    BrandDto model = new BrandDto();

    async void OnSubmit(BrandDto model)
    {
        DialogService.Close(model);
    }
}
