@inject DialogService DialogService
@inject HttpInterceptorService Interceptor
@inject IPacientService pacientService
@page "/paciente"

<h3>Paciente</h3>

<RadzenStack Orientation="Orientation.Horizontal" class="rz-my-5">
    <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Text="Nuevo Paciente" Click=@AddRow />
</RadzenStack>
<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="9" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedItems>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(PacientDto.Id)" Filterable="false" Title="Historia" Frozen="true" Width="50px" TextAlign="TextAlign.Center">
            <Template Context="model">
                @model.Id.ToString().PadLeft(6, '0')
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(PacientDto.FullName)" Title="Nombres y Apellidos" Frozen="true" Width="200px" Sortable="true" Filterable="true" />
        <RadzenDataGridColumn Property="@nameof(PacientDto.TypeSexId)" Title="Sexo" Frozen="true" Width="100px" Sortable="true" Filterable="true">
            <Template Context="model">
                @model.TypeSexId.GetDisplayDescription()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(PacientDto.Birthdate)" Title="Fecha Nac" Frozen="true" Width="100px" Sortable="true" Filterable="true" FormatString="{0:dd/MM/yyyy}" />
        <RadzenDataGridColumn Property="@nameof(PacientDto.Address)" Title="Domicilio" Frozen="true" Width="100px" Sortable="true" Filterable="true" />
        <RadzenDataGridColumn Title="Acciones" Context="model" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" Width="80px" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="model">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => EditRow(model))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(() => DeleteRow(model))" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
@code {
    IQueryable<PacientDto> items;
    IList<PacientDto> selectedItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Interceptor.RegisterEvent();

        await pacientService.GetAdminPacients();
        pacientService.OnChange += StateHasChanged;
        items = pacientService.AdminPacients.AsQueryable();

        selectedItems = new List<PacientDto>() { items.FirstOrDefault() };
    }

    public void Dispose()
    {
        Interceptor.DisposeEvent();
        pacientService.OnChange -= StateHasChanged;
    }

    async Task AddRow()
    {
        PacientDto data = await DialogService.OpenAsync<PacientAdd>("Nuevo Paciente");
        if (data != null)
        {
            await pacientService.AddPacient(data);
            items = pacientService.AdminPacients.AsQueryable();
        }
    }

    async Task EditRow(PacientDto model)
    {
        PacientDto data = await DialogService.OpenAsync<PacientEdit>("Editar Paciente", new Dictionary<string, object> { { "Param", model } });
        if (data != null)
        {
            await pacientService.UpdatePacient(data);
        }
    }

    async Task DeleteRow(PacientDto model)
    {
        var isDeleted = await DialogService.Confirm($"¿Está seguro de eliminar el paciente {model.FullName}?", "Eliminar Paciente", new ConfirmOptions() { OkButtonText = "Sí", CancelButtonText = "No" });
        
        if(isDeleted.Value){
            await pacientService.DeletePacient(model.Id);
            items = pacientService.AdminPacients.AsQueryable();
        }
    }
}