@inherits LayoutComponentBase
@inject CookieThemeService CookieThemeService
<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0">
            <RadzenColumn Size="5">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="Radzen.AlignItems.Center" class="rz-py-2" Style="padding: var(--rz-panel-menu-item-padding); border-bottom: var(--rz-panel-menu-item-border);">
                    <RadzenSidebarToggle Click="@SidebarToggleClick"></RadzenSidebarToggle>
                    <RadzenImage Path="images/logo.png" style="width: 40px" class="rz-mr-4 rz-border-radius-2" AlternateText="Application logo"></RadzenImage>
                    <RadzenText Text="Thaniwasi" TextStyle="Radzen.Blazor.TextStyle.DisplayH5" class="rz-mb-0" style="color: var(--rz-sidebar-toggle-color);" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="7">
                <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-px-2">

                    <AuthorizeView>
                        <Authorized>
                            <RadzenMenu>
                                <RadzenMenuItem Text="@context.User.Identity?.Name" Style="font-size: 18px; color: var(--rz-sidebar-toggle-color);">
                                    <RadzenMenuItem Text="Perfil" Icon="person"></RadzenMenuItem>
                                    <RadzenMenuItem Text="Configuración" Icon="settings"></RadzenMenuItem>
                                    <RadzenMenuItem Text="Cerrar Sesión" Icon="power_settings_new" Path="/logout"></RadzenMenuItem>
                                </RadzenMenuItem>
                            </RadzenMenu>
                        </Authorized>
                        <NotAuthorized>
                            <RadzenLink Text=" Ingresar" class="rz-w-fit-content" Path="/login" Icon="lock_open" Target="_self" Style="font-size: 18px; color: var(--rz-sidebar-toggle-color);" />
                        </NotAuthorized>
                    </AuthorizeView>


                    <RadzenAppearanceToggle />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenHeader>
    <RadzenBody Expanded="@sidebarExpanded">
        <RadzenRow class="rz-mx-auto rz-px-4 rz-pt-2 rz-pt-md-4 rz-pt-lg-6 rz-pt-xl-12 rz-pb-2 rz-pb-lg-12" Style="max-width: 1440px;">
            <RadzenColumn Size="12">
                @Body
            </RadzenColumn>
        </RadzenRow>
    </RadzenBody>
    <RadzenSidebar @bind-Expanded="@sidebarExpanded" style="z-index: 2; width: 200px">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Path="" />
            <RadzenPanelMenuItem Text="Pacientes" Icon="person">
                <RadzenPanelMenuItem Text="Citas" Path="/citas" />
                <RadzenPanelMenuItem Text="Paciente" Path="/paciente" />
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Sistema" Icon="settings">
                <RadzenPanelMenuItem Text="Categoría" Path="/categoria" />
                <RadzenPanelMenuItem Text="Consultorio" Path="/consultorio" />
                <RadzenPanelMenuItem Text="Especialista" Path="/especialista" />
            </RadzenPanelMenuItem>
        </RadzenPanelMenu>
        <RadzenStack AlignItems="Radzen.AlignItems.Center" Gap="0" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding);">
            <RadzenText Text="Thaniwasi v1.0.0" TextStyle="Radzen.Blazor.TextStyle.Caption" Style="color:lightgrey" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
            <RadzenText Text="Copyright Ⓒ 2025" TextStyle="Radzen.Blazor.TextStyle.Caption" Style="color:lightgrey" class="rz-mb-0" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
        </RadzenStack>

    </RadzenSidebar>
</RadzenLayout>
