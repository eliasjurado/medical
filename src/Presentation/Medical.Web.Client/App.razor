@inherits BootstrapModuleComponentBase
@attribute [JSModuleAutoLoader("./App.razor.js", JSObjectReference = true, AutoInvokeDispose = false)]
<BootstrapBlazorRoot>
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <PageTitle>Bootstrap Blazor Project Template</PageTitle>
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" >
                    <NotAuthorized>
                        <h3>Whoops! You're not allowed to see this page.</h3>
                        <h5>Please <a href="login">login</a> or <a href="register">register</a> for a new account.</h5>
                    </NotAuthorized>
                </AuthorizeRouteView>
            </Found>
            <NotFound>
                <PageTitle>Not found</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p>Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
</BootstrapBlazorRoot>
